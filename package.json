{
  "name": "hawaii-resilience-map",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:stack": "node scripts/dev-stack.mjs",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "backend:run": "cd backend && go run ./cmd/server",
    "backend:test": "cd backend && go test ./...",
    "test:integration": "playwright test --config=playwright.integration.config.ts",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "test:journey": "npm run build && PLAYWRIGHT_PERFORMANCE_RUN=1 PLAYWRIGHT_FRONTEND_COMMAND='npm run preview -- --host 127.0.0.1 --port 3000' playwright test tests/challenge-journey.spec.ts --workers=1 && node scripts/summarize-e2e-performance.mjs",
    "test:e2e": "npm run build && PLAYWRIGHT_FRONTEND_COMMAND='npm run preview -- --host 127.0.0.1 --port 3000' playwright test && npm run test:integration"
  },
  "dependencies": {
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "maplibre-gl": "^6.14.0",
    "motion": "^14.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-map-gl": "^8.1.3",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
